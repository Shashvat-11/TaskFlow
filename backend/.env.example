# Copy these values into your local environment or IDE run configuration.
# Do not commit a populated .env file.
TASKFLOW_DB_URL=jdbc:mysql://localhost:3306/your_database_name?useSSL=false&serverTimezone=UTC
TASKFLOW_DB_USERNAME=your_mysql_username
TASKFLOW_DB_PASSWORD=your_mysql_password
TASKFLOW_JPA_DDL_AUTO=validate
TASKFLOW_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
TASKFLOW_JWT_EXPIRATION=86400000
